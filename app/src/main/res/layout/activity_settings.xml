<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- APPEARANCE -->
        <TextView
            android:id="@+id/headerAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="APPEARANCE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Theme"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Light" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Dark" />
        </RadioGroup>

        <TextView
            android:id="@+id/accentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Accent color: Orange"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/accentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <!-- EDITOR -->
        <TextView
            android:id="@+id/headerEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="EDITOR"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fontSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Font size: 16"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/fontSizeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="3" />

        <TextView
            android:id="@+id/lineSpacingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Line spacing: 2sp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/lineSpacingSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8"
            android:progress="2" />

        <CheckBox
            android:id="@+id/checkMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Monospace font"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkLineNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Line numbers"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkWordWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Word wrap"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkSyntax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Syntax highlighting (code files)"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkAutoIndent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Auto indent"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkAccessory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Accessory view (symbol bar)"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Show word suggestions while typing"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkAutoCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Auto capitalize sentences"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkUndoByBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Undo with the Back button"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnIndent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Indentation: 4 spaces"
            android:textAllCaps="false" />

        <!-- FILES & SAVING -->
        <TextView
            android:id="@+id/headerFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="FILES &amp; SAVING"
            android:textSize="12sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkAutosave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Autosave"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkAutosaveConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Show a message when autosave succeeds"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAutosaveInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Autosave interval: 1 minute"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnEncoding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Default encoding: UTF-8"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnLineBreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Line break: LF"
            android:textAllCaps="false" />

        <CheckBox
            android:id="@+id/checkTypeFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Show only text files when opening"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/checkResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Resume session (restore open files)"
            android:textSize="16sp" />

        <!-- ABOUT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="ABOUT"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="EditNote 1.0.2\nA small, offline text editor.\nNo ads. No internet. Files stay on your device, where you put them.\nMade by KiA."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
