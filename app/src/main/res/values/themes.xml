<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base name kept for the manifest; ThemeHelper picks the exact
         Light/Dark + accent style at runtime, so EVERY framework control
         (checkboxes, radios, seek bars, dialogs, cursor) follows the
         user's chosen color. -->
    <style name="Theme.EditNote" parent="Theme.EditNote.Light.Orange" />

    <!-- Light -->
    <style name="Theme.EditNote.Light.Orange" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#F46658</item>
        <!-- KiA (item 72): the light background was #FAFAFA — a hair
             from white, so white cards and their hairline borders
             vanished into it and every screen looked washed out.
             A real light grey (#F1F1F4, matching Palette.surface)
             lets white cards read as cards again. -->
        <item name="android:windowBackground">#F1F1F4</item>
        <item name="android:statusBarColor">#F1F1F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F1F1F4</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.EditNote.Light.Green" parent="Theme.EditNote.Light.Orange">
        <item name="android:colorAccent">#006633</item>
    </style>
    <style name="Theme.EditNote.Light.Blue" parent="Theme.EditNote.Light.Orange">
        <item name="android:colorAccent">#FFCCFF</item>
    </style>
    <style name="Theme.EditNote.Light.Purple" parent="Theme.EditNote.Light.Orange">
        <item name="android:colorAccent">#4C0099</item>
    </style>
    <style name="Theme.EditNote.Light.Teal" parent="Theme.EditNote.Light.Orange">
        <item name="android:colorAccent">#FFFFCC</item>
    </style>
    <style name="Theme.EditNote.Light.Mono" parent="Theme.EditNote.Light.Orange">
        <item name="android:colorAccent">#111111</item>
    </style>

    <!-- Dark -->
    <style name="Theme.EditNote.Dark.Orange" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#F46658</item>
        <item name="android:windowBackground">#111111</item>
        <item name="android:statusBarColor">#111111</item>
        <item name="android:navigationBarColor">#111111</item>
    </style>
    <style name="Theme.EditNote.Dark.Green" parent="Theme.EditNote.Dark.Orange">
        <item name="android:colorAccent">#006633</item>
    </style>
    <style name="Theme.EditNote.Dark.Blue" parent="Theme.EditNote.Dark.Orange">
        <item name="android:colorAccent">#FFCCFF</item>
    </style>
    <style name="Theme.EditNote.Dark.Purple" parent="Theme.EditNote.Dark.Orange">
        <item name="android:colorAccent">#4C0099</item>
    </style>
    <style name="Theme.EditNote.Dark.Teal" parent="Theme.EditNote.Dark.Orange">
        <item name="android:colorAccent">#FFFFCC</item>
    </style>
    <style name="Theme.EditNote.Dark.Mono" parent="Theme.EditNote.Dark.Orange">
        <item name="android:colorAccent">#FFFFFF</item>
    </style>
</resources>
