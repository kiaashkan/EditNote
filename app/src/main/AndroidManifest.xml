<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions: EditNote was zero-permission by design
         (KiA reaffirmed this on 2026-11-15, cancelling the
         item-66 all-files-access idea the same night it was
         drafted). Item 110 (KiA's explicit order, 2026-11-19)
         adds note reminders, which inherently need the four
         permissions below — and ONLY those: still no INTERNET,
         still fully offline, no storage or location access.
         Files come through the system picker (persistable
         grants, item 61) or other apps' intents; read-only
         sources are handled by item 65's create-a-copy save
         flow. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Item 101 (KiA, 2026-11-17): no Android Auto Backup either —
         the app is fully offline, so its private data (drafts,
         recents, settings) must not ride along into the phone's
         Google Drive backup or a device-to-device transfer. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EditNote">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Item 110: note reminders. The alarm receiver is
             private; the boot receiver must be exported so the
             system can deliver BOOT_COMPLETED (a protected
             broadcast only the system can send). -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Open text files from file managers and other apps.
                 Item 73 (KiA): besides text/*, the text formats that
                 Android files under application/* are listed too, so
                 "Open with" offers EditNote for them as well. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/toml" />
            </intent-filter>
        </activity>
    </application>
</manifest>
